Subject: lib: on OpenVMS, include float+.h as float_plus.h

VSI C does not find a header whose name contains "+" (%CC-F-NOINCLFILEF
for "float+.h").  tools/prepare.sh copies lib/float+.h to
lib/float_plus.h; include it by that name on VMS.

--- a/lib/integer_length.c	2026-10-04 14:02:18.470092573 +0100
+++ b/lib/integer_length.c	2026-10-04 14:02:18.470539832 +0100
@@ -23,7 +23,11 @@
 
 #include <limits.h>
 
-#include "float+.h"
+#ifdef __VMS
+# include "float_plus.h"
+#else
+# include "float+.h"
+#endif
 
 #if defined _MSC_VER && !(__clang_major__ >= 4)
 # include <intrin.h>
--- a/lib/isnan.c	2026-10-04 14:02:18.472752544 +0100
+++ b/lib/isnan.c	2026-10-04 14:02:18.473047563 +0100
@@ -33,7 +33,11 @@
 #include <float.h>
 #include <string.h>
 
-#include "float+.h"
+#ifdef __VMS
+# include "float_plus.h"
+#else
+# include "float+.h"
+#endif
 
 #ifdef USE_LONG_DOUBLE
 # define FUNC rpl_isnanl
--- a/lib/signbitd.c	2026-10-04 14:02:18.474663852 +0100
+++ b/lib/signbitd.c	2026-10-04 14:02:18.474923301 +0100
@@ -21,7 +21,11 @@
 
 #include <string.h>
 #include "isnand-nolibm.h"
-#include "float+.h"
+#ifdef __VMS
+# include "float_plus.h"
+#else
+# include "float+.h"
+#endif
 
 #ifdef gl_signbitd_OPTIMIZED_MACRO
 # undef gl_signbitd
--- a/lib/signbitf.c	2026-10-04 14:02:18.476388125 +0100
+++ b/lib/signbitf.c	2026-10-04 14:02:18.476626980 +0100
@@ -21,7 +21,11 @@
 
 #include <string.h>
 #include "isnanf-nolibm.h"
-#include "float+.h"
+#ifdef __VMS
+# include "float_plus.h"
+#else
+# include "float+.h"
+#endif
 
 #ifdef gl_signbitf_OPTIMIZED_MACRO
 # undef gl_signbitf
--- a/lib/signbitl.c	2026-10-04 14:02:18.478130555 +0100
+++ b/lib/signbitl.c	2026-10-04 14:02:18.478362139 +0100
@@ -21,7 +21,11 @@
 
 #include <string.h>
 #include "isnanl-nolibm.h"
-#include "float+.h"
+#ifdef __VMS
