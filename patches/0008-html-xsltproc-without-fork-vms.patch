Subject: src/print-xml.c: on OpenVMS, run xsltproc without fork()

--html runs xsltproc through gnulib's execute(), which needs fork() or
its posix_spawn emulation; OpenVMS has neither.  Run it in a subprocess
with vms_spawn_image() (patch 0006), as m4 is run, with no standard input
or output; %define tool.xsltproc names the image as a VMS file
specification.

--- a/src/print-xml.c	2026-10-04 23:39:05.255561986 +0100
+++ b/src/print-xml.c	2026-10-04 23:40:07.825568774 +0100
@@ -29,7 +29,11 @@
 #include "closure.h"
 #include "complain.h"
 #include "conflicts.h"
-#include "execute.h"
+#ifdef __VMS
+# include "output.h"
+#else
+# include "execute.h"
+#endif
 #include "files.h"
 #include "getargs.h"
 #include "gram.h"
@@ -562,6 +566,14 @@
       fputc ('\n', stderr);
     }
 
+#ifdef __VMS
+  /* OpenVMS has no fork(), so no execute(); run xsltproc (named by
+     %define tool.xsltproc, as a VMS file specification) in a subprocess,
+     as output.c runs m4, with no standard input or output.  */
+  int status = vms_spawn_image (argv[0], argv, "NL:", "NL:");
+  if (status < 0)
+    status = 127;
+#else
   int status
     = execute (argv[0],
                argv[0], argv,
@@ -570,6 +582,7 @@
                /* null_stdin, null_stdout, null_stderr */ true, true, true,
                /* slave_process */ true, /* exit_on_error */ false,
                /* termsigp */ NULL);
+#endif
   if (status)
     complain (NULL, complaint, _("%s failed with status %d"), argv[0], status);
   free (xsltproc);
