+#ifdef __VMS
+/* Delete every version of NAME.  */
+static void
+vms_delete_all (char const *name)
+{
+  char spec[80];
+  struct dsc$descriptor_s d;
+  snprintf (spec, sizeof spec, "%s;*", name);
+  d.dsc$w_length = (unsigned short) strlen (spec);
+  d.dsc$b_dtype = DSC$K_DTYPE_T;
+  d.dsc$b_class = DSC$K_CLASS_S;
+  d.dsc$a_pointer = spec;
+  lib$delete_file (&d, 0, 0, 0, 0, 0, 0, 0, 0, 0);
+}
+
+/* Run the image IMAGE with the arguments ARGV[1...] (ARGV ends with NULL)
+   on OpenVMS, its standard input and output being the files IN and OUT.
+   Return its exit code (0 for success), or -1 if it could not be run.
+
+   It runs in a subprocess (LIB$SPAWN) executing a small generated DCL
+   procedure, not with vfork()/execv(): a child created that way inherits
+   bison's SYS$OUTPUT, and when that is redirected to a file the child
+   opens it again, leaving a new, empty version of the user's file.  The
+   procedure drops the SYS$OUTPUT and SYS$ERROR it inherits, points its
+   own SYS$INPUT and SYS$OUTPUT at IN and OUT, and runs the image with
+   every argument quoted, so DCL keeps their case.  The subprocess's own
+   output (the image's messages) goes to a temporary log, copied to stderr
+   afterwards.  */
+int
+vms_spawn_image (char const *image, char const *const *argv,
+                 char const *in, char const *out)
+{
+  static unsigned int counter;
+  char com[80], log[80], spawncmd[96];
+  struct dsc$descriptor_s cmd_d, log_d;
+  unsigned int status, completion = 0;
+  char const *const *a;
+  FILE *c;
+  int rc;
+
+  ++counter;
+  snprintf (com, sizeof com, "SYS$SCRATCH:BISON_%08X_%u_COM.TMP",
+            (unsigned int) getpid (), counter);
+  snprintf (log, sizeof log, "SYS$SCRATCH:BISON_%08X_%u_LOG.TMP",
+            (unsigned int) getpid (), counter);
+  c = fopen (com, "w");
+  if (!c)
+    return -1;
+  fputs ("$ set noon\n"
+         "$ set message/nofacility/noseverity/noidentification/notext\n"
+         "$ if f$trnlnm(\"SYS$OUTPUT\",\"LNM$PROCESS\",,\"USER\") .nes. \"\""
+         " then deassign/user sys$output\n"
+         "$ if f$trnlnm(\"SYS$OUTPUT\",\"LNM$PROCESS\",,\"SUPERVISOR\") .nes. \"\""
+         " then deassign sys$output\n"
+         "$ if f$trnlnm(\"SYS$ERROR\",\"LNM$PROCESS\",,\"USER\") .nes. \"\""
+         " then deassign/user sys$error\n"
+         "$ if f$trnlnm(\"SYS$ERROR\",\"LNM$PROCESS\",,\"SUPERVISOR\") .nes. \"\""
+         " then deassign sys$error\n"
+         "$ set message/facility/severity/identification/text\n", c);
+  fprintf (c, "$ define/user sys$input %s\n", in);
+  fprintf (c, "$ define/user sys$output %s\n", out);
+  fprintf (c, "$ mcr %s", image);
+  /* One argument per line: DCL limits the length of a record.  */
+  for (a = argv + 1; *a; a++)
+    {
+      char const *p;
+      fputs (" -\n \"", c);
+      for (p = *a; *p; p++)
+        {
+          if (*p == '"')
+            putc ('"', c);      /* DCL doubles quotes */
+          putc (*p, c);
+        }
+      putc ('"', c);
+    }
+  fputs ("\n$ exit $status\n", c);
+  if (fclose (c) != 0)
+    {
+      vms_delete_all (com);
+      return -1;
+    }
+
+  snprintf (spawncmd, sizeof spawncmd, "@%s", com);
+  cmd_d.dsc$w_length = (unsigned short) strlen (spawncmd);
+  cmd_d.dsc$b_dtype = DSC$K_DTYPE_T;
+  cmd_d.dsc$b_class = DSC$K_CLASS_S;
+  cmd_d.dsc$a_pointer = spawncmd;
+  log_d.dsc$w_length = (unsigned short) strlen (log);
+  log_d.dsc$b_dtype = DSC$K_DTYPE_T;
+  log_d.dsc$b_class = DSC$K_CLASS_S;
+  log_d.dsc$a_pointer = log;
+  fflush (stdout);
+  fflush (stderr);
+  status = lib$spawn (&cmd_d, 0, &log_d, 0, 0, 0, &completion,
+                      0, 0, 0, 0, 0, 0);
+  vms_delete_all (com);
+  c = fopen (log, "r");
+  if (c)
+    {
+      int ch;
+      while ((ch = getc (c)) != EOF)
+        putc (ch, stderr);
+      fclose (c);
+    }
+  vms_delete_all (log);
+  if (!(status & 1))
+    return -1;
+  if (completion & 1)
+    return 0;
+  /* A C program's exit (N) is %X35A000 + N*8 + severity (see vms_exit);
+     anything else is a VMS condition: report it as 1.  */
+  rc = (completion & 0x7F8) >> 3;
+  if ((completion & 0x0FFFF800) != 0x0035A000 || rc == 0)
+    rc = 1;
+  return rc;
+}
+
+/* Run M4 with ARGV on OpenVMS.  bison writes all of m4's input before it
+   reads any output, so files do the work of the two pipes: the muscles go
+   to a temporary file that is m4's standard input, m4's standard output
+   goes to another, and bison then scans that.  *PIDP is unused (no pipes
+   to wait on).  */
+static void
+vms_run_m4 (char const *m4, char **argv, pid_t *pidp)
+{
+  static unsigned int counter;
+  char in_name[64], out_name[64];
+  int rc;
+  FILE *f;
+
+  (void) pidp;
+  snprintf (in_name, sizeof in_name, "SYS$SCRATCH:BISON_%08X_%u_IN.TMP",
+            (unsigned int) getpid (), ++counter);
+  snprintf (out_name, sizeof out_name, "SYS$SCRATCH:BISON_%08X_%u_OUT.TMP",
+            (unsigned int) getpid (), counter);
+
+  f = xfopen (in_name, "w");
+  muscles_output (f);
+  xfclose (f);
+  if (trace_flag & trace_muscles)
+    muscles_output (stderr);
+
+  timevar_push (tv_m4);
+  rc = vms_spawn_image (m4, (char const *const *) argv, in_name, out_name);
+  if (rc != 0)
+    {
+      vms_delete_all (in_name);
+      vms_delete_all (out_name);
+      if (rc < 0)
+        error (EXIT_FAILURE, 0, _("cannot run %s"), m4);
+      error (EXIT_FAILURE, 0, _("%s subprocess failed with exit code %d"),
+             m4, rc);
+    }
+
+  f = xfopen (out_name, "r");
+  scan_skel (f);
+  /* scan_skel should have read all of M4's output.  */
+  aver (feof (f));
+  xfclose (f);
+  timevar_pop (tv_m4);
+  vms_delete_all (in_name);
+  vms_delete_all (out_name);
+}
+#endif
