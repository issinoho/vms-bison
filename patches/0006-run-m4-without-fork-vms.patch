+#ifdef __VMS
+/* Run M4 with ARGV on OpenVMS.  bison writes all of m4's input before it
+   reads any output, so files do the work of the two pipes: the muscles go
+   to a temporary file that is m4's standard input, m4's standard output
+   goes to another, and bison then scans that.  The child is started with
+   vfork() and execv(), with descriptors 0 and 1 redirected around the
+   vfork() in the parent; the C RTL passes the arguments to the child as
+   they are, so their case is kept.  *PIDP is unused (no pipes to wait
+   on).  */
+static void
+vms_run_m4 (char const *m4, char **argv, pid_t *pidp)
+{
+  static unsigned int counter;
+  char in_name[64], out_name[64];
+  int in_fd, out_fd, saved_in, saved_out, status = 0;
+  pid_t pid;
+  FILE *f;
+
+  (void) pidp;
+  snprintf (in_name, sizeof in_name, "SYS$SCRATCH:BISON_%08X_%u_IN.TMP",
+            (unsigned int) getpid (), ++counter);
+  snprintf (out_name, sizeof out_name, "SYS$SCRATCH:BISON_%08X_%u_OUT.TMP",
+            (unsigned int) getpid (), counter);
+
+  f = xfopen (in_name, "w");
+  muscles_output (f);
+  xfclose (f);
+  if (trace_flag & trace_muscles)
+    muscles_output (stderr);
+
+  timevar_push (tv_m4);
+  f = xfopen (out_name, "w");
+  in_fd = open (in_name, O_RDONLY);
+  if (in_fd < 0)
+    error (EXIT_FAILURE, get_errno (), "%s", in_name);
+  out_fd = fileno (f);
+  fflush (stdout);
+  saved_in = dup (0);
+  saved_out = dup (1);
+  dup2 (in_fd, 0);
+  dup2 (out_fd, 1);
+  pid = vfork ();
+  if (pid == 0)
+    {
+      execv (m4, argv);
+      _exit (127);
+    }
+  dup2 (saved_in, 0);
+  dup2 (saved_out, 1);
+  close (saved_in);
+  close (saved_out);
+  close (in_fd);
+  xfclose (f);
+  if (pid < 0)
+    error (EXIT_FAILURE, get_errno (), _("%s subprocess failed"), "m4");
+  if (waitpid (pid, &status, 0) < 0)
+    error (EXIT_FAILURE, get_errno (), _("%s subprocess failed"), "m4");
+  if (!WIFEXITED (status) || WEXITSTATUS (status) != 0)
+    error (EXIT_FAILURE, 0, _("%s subprocess failed with exit code %d"),
+           m4, WIFEXITED (status) ? WEXITSTATUS (status) : -1);
+
+  f = xfopen (out_name, "r");
+  scan_skel (f);
+  /* scan_skel should have read all of M4's output.  */
+  aver (feof (f));
+  xfclose (f);
+  timevar_pop (tv_m4);
+  while (remove (in_name) == 0)       /* every version */
+    ;
+  while (remove (out_name) == 0)
+    ;
+}
+#endif
